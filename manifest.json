{
  "manifest_version": 2,
  "name": "Claude Usage Meter",
  "version": "0.2.0",
  "description": "Shows Claude plan, 5-hour and weekly usage, reset timing, and estimated conversation tokens below the composer.",
  "icons": {
    "48": "icons/joker-48.png",
    "96": "icons/joker-96.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "https://claude.ai/*",
    "https://www.claude.ai/*"
  ],
  "background": {
    "scripts": [
      "src/lib/shared.js",
      "src/lib/tokenizer.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://www.claude.ai/*"
      ],
      "js": [
        "src/lib/shared.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage-meter@local", 
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
